# teknikel-site
DirectoryIndex index.php
Options -Indexes
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
RewriteEngine On
# Retain legacy sources locally; never serve the retired custom widget/logic.
RewriteRule ^assets/(?:assistant|i18n)(?:/|$) - [F,L,NC]
RewriteRule ^assets/[^/]+\.(?:js|mjs|php)$ - [F,L,NC]
RewriteRule ^(?:canonical|inc|core|site|public|locales|tools|docs|config|storage|data-import|tests|node_modules|scripts)(?:/|$) - [F,L,NC]
RewriteRule ^yardimci-asistan/(?:config|data|lib|knowledge)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L,NC]
<FilesMatch "(^\.|\.(?:md|sh|bak)$)">
  Require all denied
</FilesMatch>

# Existing route wrappers and the site-owned demo remain files. Unknown paths
# enter common aliases/missing-page gates; the API namespace is never rewritten.
RewriteCond %{REQUEST_URI} !^/yardimci-asistan(?:/|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
